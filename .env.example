# Public site URL (used for SEO, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.pk

# Brand film for the homepage (hosted MP4/WebM). Moves to admin panel in Stage 5.
NEXT_PUBLIC_AD_VIDEO_URL=

# Newsletter: Mailchimp / Klaviyo / Zapier webhook that receives {email, source}
NEWSLETTER_WEBHOOK_URL=

# ── Supabase (Stage 4) — Project Settings → API Keys ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key — server only. Needed before running supabase/migrations/004_lockdown.sql.
# Add it here AND in your hosting dashboard. NEVER commit or share it, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Stage 6: payment gateways (sandbox first) ──
# SAFEPAY_API_KEY= / SAFEPAY_SECRET= / SAFEPAY_WEBHOOK_SECRET=
# PAYFAST_MERCHANT_ID= / PAYFAST_SECURED_KEY=
# JAZZCASH_MERCHANT_ID= / JAZZCASH_PASSWORD= / JAZZCASH_INTEGRITY_SALT=
# EASYPAISA_STORE_ID= / EASYPAISA_HASH_KEY=

# ── Stage 7: couriers ──
# TCS_API_KEY= / LEOPARDS_API_KEY= / LEOPARDS_API_PASSWORD= / TRAX_API_KEY= / MNP_USERNAME= / MNP_PASSWORD=

# ── Stage 8: analytics ──
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
